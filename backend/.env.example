APP_NAME=Student Project Hub API
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/student_project_hub
# Generate a cryptographically secure key with at least 32 random bytes:
# python -c "import secrets; print(secrets.token_hex(32))"
# Replace this placeholder in backend/.env. Never commit the generated value.
SECRET_KEY=REPLACE_ME
FRONTEND_URL=http://127.0.0.1:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local HTTP development: false. Set true for HTTPS deployments.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
